{
  "name": "ankerzug",
  "version": "0.1.1",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "test": "ng test --watch=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/verify-third-party-notices.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "rust:check": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "explore": "node scripts/explore.mjs",
    "explore:test": "node --test scripts/exploration/*.test.mjs",
    "explore:smoke": "node scripts/exploration/smoke.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@tauri-apps/api": "2.12.4",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.4.299",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@tauri-apps/cli": "2.12.4",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
