{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ankerzug",
  "version": "0.0.1",
  "identifier": "net.ankerzug.planner",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/ankerzug/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Ankerzug \u2013 Trainingsplanung",
        "width": 1280,
        "height": 850,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Sports",
    "shortDescription": "Offline Trainingsplanung f\u00fcr den Bogensport",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
